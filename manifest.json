{
  "manifest_version": "0.4",
  "name": "nitro-mcp",
  "display_name": "Nitro Document Automation",
  "version": "2026.03.31.01",
  "description": "Nitro Document Automation MCP server",
  "author": {
    "name": "Nitro Software Inc."
  },
  "license": "Proprietary",
  "server": {
    "type": "uv",
    "entry_point": "app.server",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "python",
        "-m",
        "app.server"
      ],
      "env": {
        "NITRO_TARGET_ENV": "dev",
        "NITRO_AUTH_MODE": "client-credentials",
        "NITRO_CLIENT_ID": "${user_config.client_id}",
        "NITRO_CLIENT_SECRET": "${user_config.client_secret}"
      }
    }
  },
  "user_config": {
    "client_id": {
      "type": "string",
      "title": "Client ID",
      "description": "Your Nitro OAuth client ID",
      "required": true
    },
    "client_secret": {
      "type": "string",
      "title": "Client Secret",
      "description": "Your Nitro OAuth client secret",
      "required": true,
      "sensitive": true
    }
  }
}
