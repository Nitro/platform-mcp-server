{
  "manifest_version": "0.4",
  "name": "nitro-mcp",
  "display_name": "Nitro PDF Services",
  "version": "0.23.0",
  "description": "Nitro PDF Services MCP server",
  "icon": "icon.png",
  "keywords": [
    "pdf",
    "convert",
    "merge",
    "split",
    "redact",
    "pii",
    "extract",
    "ocr"
  ],
  "author": {
    "name": "Nitro Software Inc.",
    "email": "support@gonitro.com",
    "url": "https://www.gonitro.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nitro/platform-mcp-server"
  },
  "privacy_policies": [
    "https://www.gonitro.com/legal/privacy-policy",
    "https://www.gonitro.com/security-compliance/artificial-intelligence",
    "https://www.gonitro.com/security-compliance/data-protection/subprocessors-and-subcontractors",
    "https://www.gonitro.com/security-compliance/data-protection/processing-of-personal-data",
    "https://www.gonitro.com/hubfs/information-security-policy.pdf"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/bundle.cjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/bundle.cjs"
      ],
      "env": {
        "NITRO_TARGET_ENV": "prod",
        "NITRO_AUTH_MODE": "pkce"
      }
    }
  },
  "tools_generated": true
}
