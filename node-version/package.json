{
  "name": "nitro-mcp",
  "version": "0.26.0",
  "type": "module",
  "description": "Nitro MCP server for PDF processing",
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/index.ts",
    "bundle": "node build.mjs",
    "build": "npm run bundle",
    "check": "npm run check:format && npm run check:types && npm run check:lint",
    "check:format": "prettier --check src/ tests/",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "jimp": "^1.6.0",
    "zod": "^3.24.3"
  },
  "overrides": {
    "uuid": "^14",
    "archiver": "^8.0.0",
    "rimraf": "^6.0.0",
    "@hono/node-server": "^2.0.12",
    "brace-expansion": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jiti": "^2.6.1",
    "prettier": "^3.5.3",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^4.1.8"
  }
}
